# GEZHI micro-printer (28e9:0289): let the corkboard user write to /dev/usb/lp*
# without sudo, give it a stable name, and keep USB autosuspend from putting it to sleep.
SUBSYSTEM=="usbmisc", KERNEL=="lp[0-9]*", ATTRS{idVendor}=="28e9", ATTRS{idProduct}=="0289", MODE="0666", GROUP="lp", SYMLINK+="corkboard-printer"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="28e9", ATTR{idProduct}=="0289", TEST=="power/control", ATTR{power/control}="on"
