# Corkboard settings. Copy to .env (scripts/install.sh does this and fills in the secrets).

# --- General -------------------------------------------------------------------
# Your timezone, for due dates and the times below (IANA name).
CORKBOARD_TIMEZONE=America/New_York
# The address phones use to reach the web UI. The QR code on each card opens this.
CORKBOARD_BASE_URL=http://corkboard.local:8000
CORKBOARD_HOST=0.0.0.0
CORKBOARD_PORT=8000
# Signs the web session cookie. install.sh generates one.
CORKBOARD_SECRET_KEY=
# Optional password for the web UI (HTTP basic auth). Recommended if anything
# beyond /mcp and /github is reachable from outside your network.
CORKBOARD_WEB_USERNAME=
CORKBOARD_WEB_PASSWORD=

# --- Printer -------------------------------------------------------------------
# /dev/usb/lp0 for the USB printer, or dry-run to save cards as PNGs in data/printed/.
PRINTER_DEVICE=/dev/usb/lp0
# 384 dots for 58 mm paper. Confirm on the self-test page (hold FEED while powering on).
PRINTER_WIDTH_PX=384
# If cards come out garbled or striped, try bitImageColumn, and/or a fragment height of 256.
PRINTER_IMAGE_IMPL=bitImageRaster
PRINTER_FRAGMENT_HEIGHT=960
# Blank lines fed after each card so it tears off cleanly.
PRINTER_FEED_LINES=4
# Grey level (0-255) above which pixels print white.
PRINTER_THRESHOLD=160
# Status query sent this often while idle to stop the printer powering itself off. 0 = off.
PRINTER_KEEPALIVE_SECONDS=30
PRINT_MAX_ATTEMPTS=5

# --- Automations -----------------------------------------------------------------
PRINT_ON_CREATE=true
DIGEST_ENABLED=true
DIGEST_TIME=07:30
# Cron day-of-week syntax, e.g. mon-fri
DIGEST_DAYS=mon-sun
REMINDER_ENABLED=true
REMINDER_TIME=16:00
# Priorities that get a reprint the day before (and the day of) their due date.
REMINDER_PRIORITIES=high
OVERDUE_REPRINT_ENABLED=true
OVERDUE_REPRINT_DAY=mon
OVERDUE_REPRINT_TIME=07:35

# --- GitHub pull request reviews ----------------------------------------------------
# Fine-grained token with read access to pull requests (and metadata) on the repos
# you review, or a classic token with "repo". Leave empty to turn the poll off.
GITHUB_TOKEN=
# Your GitHub login. Needed for the webhook; looked up from the token if empty.
GITHUB_USERNAME=
GITHUB_POLL_MINUTES=5
GITHUB_SEARCH_QUERY=is:open is:pr review-requested:@me archived:false
# Labels that make a review card high (or low) priority.
GITHUB_HIGH_LABELS=urgent,hotfix
GITHUB_LOW_LABELS=
# Draft PRs: low (print as low priority) or skip (no card until ready for review).
GITHUB_DRAFT_MODE=low
# Review cards are due this many business days after they appear.
GITHUB_DUE_BUSINESS_DAYS=1
# Optional webhook at /github. Leave empty to disable the endpoint.
GITHUB_WEBHOOK_SECRET=

# --- Claude connector --------------------------------------------------------------
# The connector lives at https://<your public host>/mcp/<MCP_SECRET>. install.sh
# generates a long random value. Empty = connector off.
MCP_SECRET=
# Your public host name(s), comma separated, e.g. corkboard.example.com or
# pi.tail1234.ts.net. Turns on Host-header checks for the connector.
MCP_ALLOWED_HOSTS=
